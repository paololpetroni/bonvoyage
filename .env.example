# Copy this file to .env.local and fill in both values.
# Supabase dashboard: Project Settings > API Keys.

# Project URL, looks like https://abcdefghijkl.supabase.co
VITE_SUPABASE_URL=

# The publishable key (starts with sb_publishable_). The older "anon" key also works.
# Never put the secret or service_role key here: everything in this file ends up in the browser.
VITE_SUPABASE_KEY=
